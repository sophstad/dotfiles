# shortcut to this dotfiles path is $ZSH
export ZSH=$HOME/.dotfiles

# Theme
source $HOME/.dotfiles/zsh/apple.zsh-theme

# Syntax highlighting (brew install zsh-syntax-highlighting)
source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

################################################################################
#                                 ZSH config                                   #
################################################################################

# enable vim keybindings in the shell
bindkey -v

# enable reverse search
bindkey '^R' history-incremental-search-backward

# don't save to zsh history if suffixed with a space
setopt HIST_IGNORE_SPACE

# Completions
autoload -Uz compinit && compinit

################################################################################
#                                 environment                                  #
################################################################################

export EDITOR="nvim"
export VISUAL="nvim"
export GPG_TTY=$(tty)

################################################################################
#                                 aliases                                      #
################################################################################

alias l="ls -alF"
alias pubkey="cat ~/.ssh/id_rsa.pub | pbcopy && echo '=> Public key copied to pasteboard.'"

################################################################################
#                                 work config                                  #
################################################################################

# only present on work machines (conditionally symlinked by bootstrap)
[ -f "$HOME/.zshrc.work" ] && source "$HOME/.zshrc.work"
